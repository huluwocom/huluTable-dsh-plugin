{
  "name": "dsh-hulutable-plugin",
  "version": "0.1.0",
  "description": "huluTable \u2014 a foolproof online-table workspace plugin for DeepSeek Harness Web: table library, virtualized grid editor, formulas, kanban/calendar views, goals, and Excel import/export",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "table",
    "spreadsheet",
    "kanban",
    "database"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint src tests scripts",
    "link-sdk": "node scripts/link-sdk.mjs",
    "pack": "pnpm run build && pnpm pack --pack-destination releases"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "^1.28.0",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huluwocom/HuluTable.git"
  },
  "bugs": {
    "url": "https://github.com/huluwocom/HuluTable/issues"
  },
  "homepage": "https://github.com/huluwocom/HuluTable#readme"
}
